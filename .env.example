# Copy to .env and replace every "change_me" value.
# Generate secrets with: openssl rand -hex 32

# ---------- PostgreSQL (single instance, one schema per service) ----------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gpay
DB_USER=gpay
DB_PASSWORD=change_me

# ---------- Redis (payment idempotency/rate limits, auth login lockout) ----------
REDIS_PASSWORD=change_me

# ---------- JWT (RS256; key files come from ./keys, see scripts/generate-jwt-keys.sh) ----------
JWT_ISSUER=gpay-auth
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ---------- Service-to-service ----------
INTERNAL_API_KEY=change_me
MOCK_GATEWAY_SECRET=change_me

# ---------- Payment rules ----------
DAILY_TRANSFER_LIMIT=10000000
PENDING_EXPIRE_MINUTES=60

# ---------- Login brute-force protection ----------
LOGIN_MAX_ATTEMPTS_PER_USER=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_LOCK_MINUTES=15

# ---------- Host ports for direct DB/Redis access (optional) ----------
# Change these if 5432/6379 are already used on your machine. Services talk over
# the Docker network and are not affected.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
